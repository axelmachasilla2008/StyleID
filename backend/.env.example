# Copia este archivo como ".env" y rellena tus datos.
# NUNCA subas el archivo .env a GitHub ni lo compartas.

MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/styleid?retryWrites=true&w=majority
# Usa 3002 porque Live Preview de VS Code ocupa el 3000 (página) y el 3001 (recarga)
PORT=3002

# Acceso al panel de administrador (obligatorios: sin ellos el servidor no arranca).
# ADMIN_SECRET: texto largo y aleatorio (16 caracteres o mas); tambien firma las sesiones.
ADMIN_PASSWORD=
ADMIN_SECRET=

# Asistente de estilo con IA (opcional). Crea tu clave en https://platform.claude.com
# Sin esta clave el asistente funciona en modo basico (sin IA).
ANTHROPIC_API_KEY=

# ===== FreeLLMAPI (segunda opcion de IA, gratis) =====
# Pega tu clave unificada de la app FreeLLMAPI (Keys > Unified API key) despues del =
# La app debe estar abierta. Se usa cuando Claude no esta disponible (por ejemplo, sin saldo).
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_MODEL=qwen3.8-27b,gpt-oss-120b,auto

# ===== Fotos en la nube (Cloudinary, gratis) =====
# En cloudinary.com > Dashboard (o Settings > API Keys) copia cada dato despues de su = .
# Si los tres estan vacios, las fotos se guardan en el PC.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
